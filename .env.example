# ============================================================================
# HAOYAO（皓遥）官网 环境变量模板
# 依据：《HAOYAO_官网_开发技术文档.md》§3.5 环境变量清单
# 用法：复制为 .env（本地开发）或注入 Docker 环境（生产），
#       生产密钥通过 Docker Secret / 云厂商密钥管理注入，禁止提交到仓库。
# ============================================================================

# ---------- 通用 ----------
ENVIRONMENT=development            # development | production
APP_TIMEZONE=Asia/Shanghai

# ---------- FastAPI ----------
# 开发默认：apps/api 运行目录下的 haoyao.db；生产：sqlite:////data/haoyao.db
DATABASE_URL=sqlite:///./haoyao.db
# 生产必须替换为强随机 64 位密钥（如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=14
# 首次启动自动创建的管理员（开发默认 admin / change-me）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_INIT=change-me
# 登录限流：连续失败次数 / 锁定分钟数
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# CORS 白名单（逗号分隔；生产同域可收紧为 /api 反向代理）
CORS_ORIGINS=http://localhost:3000

# ---------- 媒体存储（M8：本地模拟存储 → 对象存储预签名） ----------
# 存储后端：local（开发，uploads/ 目录）| cos（生产，腾讯云 COS 预签名直传）
UPLOAD_BACKEND=local
# 上传文件目录（Docker 卷挂载 /data/uploads）
UPLOAD_DIR=uploads
# 媒体访问基础 URL（开发直连后端；生产替换为 CDN 域名 https://cdn.haoyao.com）
MEDIA_BASE_URL=http://localhost:8000/uploads
# 上传大小限制（字节）：图片 10MB / 视频 200MB
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=209715200
# ---------- 腾讯云 COS（UPLOAD_BACKEND=cos 时启用） ----------
COS_SECRET_ID=xxx
COS_SECRET_KEY=xxx
COS_REGION=ap-shanghai
COS_BUCKET=haoyao-1250000000
COS_PRESIGN_TTL=600              # 预签名有效期（秒）

# ---------- Next.js ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# 内部 revalidate 接口调用密钥（前后端必须一致）
ADMIN_API_KEY=revalidate-secret
# 站点对外域名（SEO canonical / sitemap / JSON-LD 用）
NEXT_PUBLIC_SITE_URL=https://www.haoyao.com
# Next.js 内部地址（后端调用 revalidate 用；Docker 内为 http://web:3000）
NEXTJS_INTERNAL_BASE=http://localhost:3000
